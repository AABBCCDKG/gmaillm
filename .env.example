OPENAI_API_KEY=replace-with-your-openai-api-key
SUMMARY_RECIPIENT=you@example.com

# Required: exactly one newsletter sender explicitly authorized for processing.
GMAIL_SENDER_FILTERS=newsletter@example.com

# Optional overrides
OPENAI_MODEL=gpt-4-1106-preview
OPENAI_TOKEN_LIMIT=128000
GMAIL_LLM_TIMEZONE=America/New_York
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_LLM_SUMMARY_DIR=summary
